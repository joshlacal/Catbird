<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CatbirdFeatures</key>
	<dict>
		<key>CirclesSpaces</key>
		<string>$(CATBIRD_FEATURE_CIRCLES_SPACES)</string>
		<key>Live</key>
		<string>$(CATBIRD_FEATURE_LIVE)</string>
		<key>MLSChat</key>
		<string>$(CATBIRD_FEATURE_MLS_CHAT)</string>
		<key>RepositoryTools</key>
		<string>$(CATBIRD_FEATURE_REPOSITORY_TOOLS)</string>
	</dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>blue.catbird.posting.retry</string>
		<string>blue.catbird.chat.refresh</string>
		<string>blue.catbird.cache.refresh</string>
		<string>blue.catbird.key-package-refresh</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>blue.catbird</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>blue.catbird</string>
				<string>catbird</string>
			</array>
		</dict>
	</array>
	<key>LegalPrivacyPolicyURL</key>
	<string>https://catbird.blue/privacy</string>
	<key>LegalTermsOfServiceURL</key>
	<string>https://catbird.blue/terms</string>
	<key>SentryLaunchProfilingEnabled</key>
	<false/>
	<key>SupportURL</key>
	<string>https://catbird.blue/support</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>remote-notification</string>
		<string>fetch</string>
		<string>processing</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIImageName</key>
		<string>LaunchIcon</string>
	</dict>
	<key>UIObservationTrackingEnabled</key>
	<true/>
	<key>CATBIRD_TELEMETRY_BACKEND</key>
	<string>$(CATBIRD_TELEMETRY_BACKEND)</string>
	<key>CATBIRD_GLITCHTIP_ALLOWED_HOST</key>
	<string>$(CATBIRD_GLITCHTIP_ALLOWED_HOST)</string>
	<key>GLITCHTIP_DSN</key>
	<string>$(CATBIRD_GLITCHTIP_DSN)</string>
</dict>
</plist>
