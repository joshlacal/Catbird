        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Catbird a kamerát használja fényképek és videók készítéséhez a bejegyzéseidhez, valamint a Bluesky-profilok QR-kódjainak beolvasásához."
