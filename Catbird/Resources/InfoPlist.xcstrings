        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catbird používá mikrofon, když nahráváte zvuk nebo video do příspěvku nebo hlasovou zprávu v chatu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catbird bruger mikrofonen, når du optager lyd eller video til et opslag eller en talebesked i en chat."
          }
