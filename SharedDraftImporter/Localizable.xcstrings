    "Catbird can share text, links, up to 4 images, or 1 video." : {
      "comment" : "Error message when shared content exceeds Catbird's attachment size or count limits.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن لـ Catbird مشاركة نصوص أو روابط أو ما يصل إلى 4 صور أو مقطع فيديو واحد."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catbird pot compartir text, enllaços, fins a 4 imatges o 1 vídeo."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catbird dokáže sdílet text, odkazy, až 4 obrázky nebo 1 video."
          }
        },
