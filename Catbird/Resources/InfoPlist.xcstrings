    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description — system permission prompt shown when taking photos or videos for a post or scanning a Bluesky profile QR code. Keep 'Catbird' and 'Bluesky' brand names untranslated.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم Catbird الكاميرا لالتقاط الصور ومقاطع الفيديو لمنشوراتك ولمسح رموز QR الخاصة بالملفات الشخصية على Bluesky."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catbird utilitza la càmera per fer fotos i vídeos per a les teves publicacions i per escanejar codis QR de perfils de Bluesky."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catbird používá fotoaparát k pořizování fotek a videí do vašich příspěvků a ke skenování QR kódů profilů na Bluesky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catbird bruger kameraet til at tage billeder og videoer til dine opslag samt til at scanne QR-koder til Bluesky-profiler."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catbird verwendet die Kamera, um Fotos und Videos für deine Posts aufzunehmen und QR-Codes von Bluesky-Profilen zu scannen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Catbird χρησιμοποιεί την κάμερα για τη λήψη φωτογραφιών και βίντεο για τις δημοσιεύσεις σας και για τη σάρωση κωδικών QR προφίλ Bluesky."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catbird uses the camera to take photos and videos for your posts and to scan Bluesky profile QR codes."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catbird uses the camera to take photos and videos for your posts and to scan Bluesky profile QR codes."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catbird uses the camera to take photos and videos for your posts and to scan Bluesky profile QR codes."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catbird uses the camera to take photos and videos for your posts and to scan Bluesky profile QR codes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catbird usa la cámara para hacer fotos y grabar vídeos para tus publicaciones y para escanear códigos QR de perfiles de Bluesky."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catbird usa la cámara para tomar fotos y grabar videos para tus publicaciones y para escanear códigos QR de perfiles de Bluesky."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catbird käyttää kameraa kuvien ja videoiden ottamiseen julkaisuihisi sekä Bluesky-profiilien QR-koodien lukemiseen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catbird utilise l’appareil photo pour prendre des photos et des vidéos pour vos publications et pour scanner les codes QR de profil Bluesky."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catbird utilise l’appareil photo pour prendre des photos et des vidéos pour vos publications et pour scanner les codes QR de profil Bluesky."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catbird משתמשת במצלמה כדי לצלם תמונות וסרטונים עבור הפוסטים שלך וכדי לסרוק קודי QR של פרופילי Bluesky."
