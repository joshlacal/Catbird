    "Breaking: New framework announced at developer conference. This changes everything for mobile development!" : {
      "comment" : "Sample post text shown in the iOS Widget Gallery preview.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عاجل: الإعلان عن إطار عمل جديد في مؤتمر المطورين. هذا يغيّر كل شيء في تطوير تطبيقات الجوّال!"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
