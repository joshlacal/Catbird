    "Touch and hold this widget, then choose Edit Widget to pick a feed." : {
      "comment" : "Empty-state instructions in the Catbird Feed widget explaining how to configure a feed.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المس هذه الأداة مطولاً، ثم اختر «تحرير الأداة» لاختيار موجز."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén premut aquest giny i selecciona «Edita el giny» per triar un canal."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podržte prst na tomto widgetu, zvolte Upravit widget a vyberte kanál."
