    "Just released v2.0 of our popular library. Major performance improvements and new API surface." : {
      "comment" : "Sample post text shown in the iOS Widget Gallery preview.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أصدرنا للتو الإصدار 2.0 من مكتبتنا الشهيرة. تحسينات كبيرة في الأداء وواجهة برمجية جديدة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acabem de publicar la v2.0 de la nostra biblioteca popular. Grans millores de rendiment i una nova interfície d'API."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Právě jsme vydali verzi 2.0 naší oblíbené knihovny. Výrazné zvýšení výkonu a nové rozhraní API."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Har netop udgivet v2.0 af vores populære bibliotek. Store ydelsesforbedringer og ny API-overflade."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gerade Version 2.0 unserer beliebten Bibliothek veröffentlicht. Deutlich mehr Tempo und eine neue API."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μόλις κυκλοφόρησε η έκδοση v2.0 της δημοφιλούς βιβλιοθήκης μας. Σημαντικές βελτιώσεις απόδοσης και νέα επιφάνεια API."
          }
        },
