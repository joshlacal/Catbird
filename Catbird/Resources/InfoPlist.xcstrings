    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - Microphone Usage Description — system permission prompt shown when recording audio or video to share in a post. Keep 'Catbird' brand name untranslated.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم Catbird الميكروفون عند تسجيل صوت أو فيديو لمنشور، أو رسالة صوتية في محادثة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catbird utilitza el micròfon quan graves àudio o vídeo per a una publicació, o un missatge de veu en un xat."
