    "NSContactsUsageDescription" : {
      "comment" : "Privacy - Contacts Usage Description — system permission prompt shown when the user opts into finding friends from their address book. Keep 'Catbird' and 'Bluesky' brand names untranslated.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عندما تختار البحث عن أصدقائك من جهات الاتصال، يرسل Catbird أرقام هواتفهم إلى خدمة مطابقة جهات الاتصال في Bluesky لإظهار من منهم موجود على Bluesky."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quan tries trobar amics a partir dels teus contactes, Catbird envia els seus números de telèfon al servei de coincidència de contactes de Bluesky per mostrar quins d'ells són a Bluesky."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když se rozhodnete najít přátele ve svých kontaktech, Catbird odešle jejich telefonní čísla službě Bluesky pro párování kontaktů, aby zobrazil, kdo z nich je na Bluesky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du vælger at finde venner blandt dine kontakter, sender Catbird deres telefonnumre til Blueskys tjeneste til kontaktmatchning for at vise, hvem af dem der er på Bluesky."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du Freunde über deine Kontakte finden möchtest, sendet Catbird deren Telefonnummern an den Kontaktabgleich-Dienst von Bluesky, um zu zeigen, wer von ihnen auf Bluesky ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όταν επιλέγετε να βρείτε φίλους από τις επαφές σας, το Catbird στέλνει τους αριθμούς τηλεφώνου τους στην υπηρεσία αντιστοίχισης επαφών του Bluesky, για να δείξει ποιοι από αυτούς βρίσκονται στο Bluesky."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you choose to find friends from your contacts, Catbird sends their phone numbers to Bluesky's contact-matching service to show which of them are on Bluesky."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you choose to find friends from your contacts, Catbird sends their phone numbers to Bluesky's contact-matching service to show which of them are on Bluesky."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you choose to find friends from your contacts, Catbird sends their phone numbers to Bluesky's contact-matching service to show which of them are on Bluesky."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you choose to find friends from your contacts, Catbird sends their phone numbers to Bluesky's contact-matching service to show which of them are on Bluesky."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando eliges buscar amigos entre tus contactos, Catbird envía sus números de teléfono al servicio de coincidencia de contactos de Bluesky para mostrarte cuáles de ellos están en Bluesky."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando eliges buscar amigos entre tus contactos, Catbird envía sus números de teléfono al servicio de coincidencia de contactos de Bluesky para mostrarte cuáles de ellos están en Bluesky."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun valitset kavereiden etsimisen yhteystiedoistasi, Catbird lähettää heidän puhelinnumeronsa Blueskyn yhteystietojen vertailupalveluun näyttääkseen, ketkä heistä ovat Blueskyssa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque vous choisissez de retrouver des amis à partir de vos contacts, Catbird envoie leurs numéros de téléphone au service de correspondance de contacts de Bluesky afin d’indiquer lesquels d’entre eux sont sur Bluesky."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque vous choisissez de retrouver des amis à partir de vos contacts, Catbird envoie leurs numéros de téléphone au service de correspondance de contacts de Bluesky afin d’indiquer lesquels d’entre eux sont sur Bluesky."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כשבוחרים למצוא חברים מאנשי הקשר שלך, Catbird שולחת את מספרי הטלפון שלהם לשירות התאמת אנשי הקשר של Bluesky כדי להראות מי מהם נמצא ב-Bluesky."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब आप अपने संपर्कों में से दोस्तों को खोजना चुनते हैं, तो Catbird उनके फ़ोन नंबर Bluesky की संपर्क-मिलान सेवा को भेजता है, ताकि यह दिखाया जा सके कि उनमें से कौन Bluesky पर है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kada odlučite pronaći prijatelje među svojim kontaktima, Catbird šalje njihove telefonske brojeve Blueskyjevoj usluzi za uparivanje kontakata kako bi prikazao tko je od njih na usluzi Bluesky."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha úgy döntesz, hogy a névjegyeid között keresel ismerősöket, a Catbird elküldi a telefonszámukat a Bluesky névjegyegyeztető szolgáltatásának, hogy megmutassa, kik vannak közülük a Bluesky-on."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat Anda memilih untuk mencari teman dari kontak, Catbird mengirim nomor telepon mereka ke layanan pencocokan kontak Bluesky untuk menunjukkan siapa saja di antara mereka yang ada di Bluesky."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando scegli di trovare amici dai tuoi contatti, Catbird invia i loro numeri di telefono al servizio di corrispondenza dei contatti di Bluesky per mostrarti chi di loro è su Bluesky."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "連絡先から友だちを探すことを選択すると、Catbirdは連絡先の電話番号をBlueskyの連絡先照合サービスに送信し、そのうちBlueskyを利用している人を表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연락처에서 친구 찾기를 선택하면 Catbird가 연락처의 전화번호를 Bluesky의 연락처 매칭 서비스로 보내 그중 Bluesky를 사용하는 사람을 보여 줍니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apabila anda memilih untuk mencari rakan daripada kenalan anda, Catbird menghantar nombor telefon mereka ke perkhidmatan pemadanan kenalan Bluesky untuk menunjukkan siapa antara mereka yang berada di Bluesky."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du velger å finne venner blant kontaktene dine, sender Catbird telefonnumrene deres til Blueskys tjeneste for kontaktsamsvar for å vise hvem av dem som er på Bluesky."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je ervoor kiest vrienden te zoeken in je contacten, stuurt Catbird hun telefoonnummers naar de contactmatchingdienst van Bluesky om te laten zien wie van hen op Bluesky zit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy zdecydujesz się wyszukać znajomych w kontaktach, Catbird wyśle ich numery telefonów do usługi dopasowywania kontaktów Bluesky, aby pokazać, którzy z nich są na Bluesky."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando você escolhe encontrar amigos nos seus contatos, o Catbird envia os números de telefone deles ao serviço de correspondência de contatos do Bluesky para mostrar quais deles estão no Bluesky."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando opta por encontrar amigos nos seus contactos, o Catbird envia os números de telefone deles para o serviço de correspondência de contactos do Bluesky para mostrar quais deles estão no Bluesky."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Când alegeți să găsiți prieteni din contactele dvs., Catbird trimite numerele lor de telefon serviciului de potrivire a contactelor al Bluesky pentru a vă arăta care dintre ei sunt pe Bluesky."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если вы решите найти друзей среди контактов, Catbird отправит их номера телефонов в сервис сопоставления контактов Bluesky, чтобы показать, кто из них есть в Bluesky."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keď sa rozhodnete nájsť priateľov vo svojich kontaktoch, Catbird odošle ich telefónne čísla službe Bluesky na párovanie kontaktov, aby zobrazil, kto z nich je na Bluesky."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När du väljer att hitta vänner bland dina kontakter skickar Catbird deras telefonnummer till Blueskys tjänst för kontaktmatchning för att visa vilka av dem som finns på Bluesky."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อคุณเลือกค้นหาเพื่อนจากรายชื่อติดต่อ Catbird จะส่งหมายเลขโทรศัพท์ของพวกเขาไปยังบริการจับคู่รายชื่อติดต่อของ Bluesky เพื่อแสดงว่าใครบ้างที่ใช้ Bluesky"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kişilerinden arkadaş bulmayı seçtiğinde Catbird, hangilerinin Bluesky'da olduğunu göstermek için telefon numaralarını Bluesky'ın kişi eşleştirme hizmetine gönderir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо ви вирішите знайти друзів серед контактів, Catbird надішле їхні номери телефонів до сервісу зіставлення контактів Bluesky, щоб показати, хто з них є в Bluesky."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi bạn chọn tìm bạn bè từ danh bạ, Catbird sẽ gửi số điện thoại của họ đến dịch vụ đối chiếu danh bạ của Bluesky để cho biết ai trong số họ đang dùng Bluesky."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當你選擇從通訊錄尋找朋友時，Catbird 會將他們的電話號碼傳送至 Bluesky 的聯絡人配對服務，以顯示當中哪些人正在使用 Bluesky。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当你选择从通讯录中查找好友时，Catbird 会将他们的电话号码发送到 Bluesky 的联系人匹配服务，以显示其中哪些人在使用 Bluesky。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當你選擇從聯絡人中尋找朋友時，Catbird 會將他們的電話號碼傳送至 Bluesky 的聯絡人配對服務，以顯示其中哪些人正在使用 Bluesky。"
          }
        }
      }
    },
    "NSFaceIDUsageDescription" : {
      "comment" : "Privacy - Face ID Usage Description — system permission prompt shown when authenticating with Face ID to unlock the app with App Lock enabled. Keep 'Catbird' untranslated and use Apple's official localized term for 'Face ID'.",
