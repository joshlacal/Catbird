        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold fingeren på denne widget, og vælg derefter Rediger widget for at vælge et feed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte dieses Widget gedrückt und wähle „Widget bearbeiten“, um einen Feed auszuwählen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
