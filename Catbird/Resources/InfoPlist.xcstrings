    "NSFaceIDUsageDescription" : {
      "comment" : "Privacy - Face ID Usage Description — system permission prompt shown when authenticating with Face ID to unlock the app with App Lock enabled. Keep 'Catbird' untranslated and use Apple's official localized term for 'Face ID'.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم Catbird بصمة الوجه (Face ID) لفتح قفل التطبيق عند تفعيل قفل التطبيق."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catbird utilitza Face ID per desbloquejar l'aplicació quan el bloqueig de l'aplicació està activat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catbird používá Face ID k odemykání aplikace, když je zapnutý Zámek aplikace."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catbird bruger Face ID til at låse appen op, når Applås er slået til."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catbird verwendet Face ID, um die App zu entsperren, wenn die App-Sperre aktiviert ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Catbird χρησιμοποιεί το Face ID για το ξεκλείδωμα της εφαρμογής όταν είναι ενεργοποιημένο το Κλείδωμα εφαρμογής."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catbird uses Face ID to unlock the app when App Lock is turned on."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catbird uses Face ID to unlock the app when App Lock is turned on."
          }
        },
