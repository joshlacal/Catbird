    "NSContactsUsageDescription" : {
      "comment" : "Privacy - Contacts Usage Description — system permission prompt shown when the user opts into finding friends from their address book. Keep 'Catbird' and 'Bluesky' brand names untranslated.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم Catbird جهات اتصالك لمساعدتك في العثور على أصدقائك والتواصل معهم على Bluesky."
