    "NSPhotoLibraryAddUsageDescription" : {
      "comment" : "Privacy - Photo Library Additions Usage Description — system permission prompt shown when saving an image from a post to the photo library. Keep 'Catbird' brand name untranslated and match the localized 'Save Image' action title.",
